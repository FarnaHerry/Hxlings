import std;
import mcpp;
import mcpp.dist.wix;
import huxerui.rules;

namespace {

void write_if_different(const std::filesystem::path& path, std::string_view bytes) {
    std::error_code ec;
    std::filesystem::create_directories(path.parent_path(), ec);
    if (std::ifstream in(path, std::ios::binary); in) {
        const std::string existing(
            (std::istreambuf_iterator<char>(in)),
            std::istreambuf_iterator<char>());
        if (existing == bytes) return;
    }
    std::ofstream out(path, std::ios::binary | std::ios::trunc);
    if (out) {
        out.write(bytes.data(), static_cast<std::streamsize>(bytes.size()));
    }
}

std::string xml_escape(std::string_view text) {
    std::string out;
    out.reserve(text.size());
    for (const char ch : text) {
        switch (ch) {
            case '&':  out += "&amp;";  break;
            case '<':  out += "&lt;";   break;
            case '>':  out += "&gt;";   break;
            case '"':  out += "&quot;"; break;
            default:   out.push_back(ch); break;
        }
    }
    return out;
}

void configure_linux_glibc_compat() {
    if (std::string_view(mcpp::target_os()) != "linux" ||
        std::string_view(mcpp::target_arch()) != "x86_64") {
        return;
    }
    const std::filesystem::path shim_path =
        std::filesystem::path(mcpp::out_dir()) / "glibc_compat_x86_64.c";
    constexpr std::string_view kShimSource =
        "float __compat_sqrtf(float x);\n"
        "float __compat_atan2f(float y, float x);\n"
        "double __compat_remainder(double x, double y);\n"
        "__asm__(\".symver __compat_sqrtf,sqrtf@GLIBC_2.2.5\");\n"
        "__asm__(\".symver __compat_atan2f,atan2f@GLIBC_2.2.5\");\n"
        "__asm__(\".symver __compat_remainder,remainder@GLIBC_2.2.5\");\n"
        "float __wrap_sqrtf(float x) { return __compat_sqrtf(x); }\n"
        "float __wrap_atan2f(float y, float x) { return __compat_atan2f(y, x); }\n"
        "double __wrap_remainder(double x, double y) { return __compat_remainder(x, y); }\n";
    write_if_different(shim_path, kShimSource);
    mcpp::source(shim_path.string().c_str());
    mcpp::link_lib("m");
    mcpp::link_flag("-Wl,--wrap=sqrtf");
    mcpp::link_flag("-Wl,--wrap=atan2f");
    mcpp::link_flag("-Wl,--wrap=remainder");
}

std::string shell_quote_single(std::string_view text) {
    std::string out;
    out.reserve(text.size() + 4);
    out.push_back('\'');
    for (const char ch : text) {
        if (ch == '\'') {
            out += "'\\''";
        } else {
            out.push_back(ch);
        }
    }
    out.push_back('\'');
    return out;
}

void run_strip_batch(std::string_view flag, const std::vector<std::string>& files) {
    if (files.empty()) return;
    constexpr std::size_t kBatchSize = 64;
    for (std::size_t i = 0; i < files.size(); i += kBatchSize) {
        std::string cmd = "strip ";
        cmd += flag;
        const std::size_t end = std::min(files.size(), i + kBatchSize);
        for (std::size_t j = i; j < end; ++j) {
            cmd.push_back(' ');
            cmd += shell_quote_single(files[j]);
        }
        cmd += " >/dev/null 2>&1 || true";
        (void)std::system(cmd.c_str());
    }
}

void strip_linux_self_contained_stage(const std::filesystem::path& stage) {
    std::error_code ec;
    const std::filesystem::path lib_dir = stage / "lib";
    if (!std::filesystem::is_directory(lib_dir, ec)) return;
    if (std::system("command -v strip >/dev/null 2>&1") != 0) return;

    std::vector<std::string> debug_only;
    std::vector<std::string> unneeded;
    for (auto it = std::filesystem::recursive_directory_iterator(
             lib_dir, std::filesystem::directory_options::skip_permission_denied, ec);
         !ec && it != std::filesystem::recursive_directory_iterator();
         it.increment(ec)) {
        std::error_code entry_ec;
        if (it->is_symlink(entry_ec) || !it->is_regular_file(entry_ec)) continue;
        const std::filesystem::path path = it->path();
        std::ifstream in(path, std::ios::binary);
        if (!in) continue;
        char magic[4]{};
        in.read(magic, 4);
        if (in.gcount() != 4 ||
            magic[0] != '\x7f' || magic[1] != 'E' || magic[2] != 'L' || magic[3] != 'F') {
            continue;
        }
        in.close();
        std::filesystem::permissions(
            path,
            std::filesystem::perms::owner_write,
            std::filesystem::perm_options::add,
            entry_ec);
        const std::string name = path.filename().string();
        if (name.starts_with("ld-linux-") || name.starts_with("libc.so")) {
            debug_only.push_back(path.string());
        } else {
            unneeded.push_back(path.string());
        }
    }
    run_strip_batch("--strip-debug", debug_only);
    run_strip_batch("--strip-unneeded", unneeded);
}

void patch_linux_self_contained_launcher() {
    if (std::string_view(mcpp::target_os()) != "linux" ||
        std::string_view(mcpp::pack_format()) != "appimage") {
        return;
    }
    const std::string stage_str = mcpp::pack_stage_dir();
    if (stage_str.empty()) return;

    const std::filesystem::path stage(stage_str);
    constexpr std::string_view kOldFlag = "--library-path \"$here/lib\"";
    constexpr std::string_view kNewFlag =
        "--library-path \"$here/lib:/usr/lib/x86_64-linux-gnu:/usr/lib64:/lib/x86_64-linux-gnu:/lib64\"";
    for (const char* name : {"hxlings", "run.sh"}) {
        const std::filesystem::path file = stage / name;
        std::ifstream in(file, std::ios::binary);
        if (!in) continue;
        std::string text((std::istreambuf_iterator<char>(in)), std::istreambuf_iterator<char>());
        in.close();
        if (text.find("/usr/lib64") != std::string::npos) continue;
        const std::size_t pos = text.find(kOldFlag);
        if (pos == std::string::npos) continue;
        text.replace(pos, kOldFlag.size(), kNewFlag);
        write_if_different(file, text);
        std::error_code ec;
        std::filesystem::permissions(
            file,
            std::filesystem::perms::owner_exec | std::filesystem::perms::group_exec |
                std::filesystem::perms::others_exec,
            std::filesystem::perm_options::add,
            ec);
    }
    strip_linux_self_contained_stage(stage);
}

huxerui::rules::options make_rules_options() {
    huxerui::rules::options opt{};
    opt.package.categories = {"Development", "Utility"};
    if (std::string_view(mcpp::target_os()) == "linux") {
        const std::string_view fmt = mcpp::pack_format();
        if (fmt == "deb") {
            opt.package.depends = {
                "libgtk-4-1 (>= 4.14)",
                "libepoxy0 (>= 1.5)",
                "libsoup-3.0-0 (>= 3.0)",
                "libpangoft2-1.0-0",
                "libfontconfig1",
            };
        } else if (fmt == "rpm") {
            opt.package.depends = {
                "libgtk-4.so.1()(64bit)",
                "libepoxy.so.0()(64bit)",
                "libsoup-3.0.so.0()(64bit)",
                "libpangoft2-1.0.so.0()(64bit)",
                "libfontconfig.so.1()(64bit)",
                "libpangocairo-1.0.so.0()(64bit)",
                "libpango-1.0.so.0()(64bit)",
                "libcairo.so.2()(64bit)",
                "libcairo-gobject.so.2()(64bit)",
                "libgdk_pixbuf-2.0.so.0()(64bit)",
                "libgraphene-1.0.so.0()(64bit)",
                "libharfbuzz.so.0()(64bit)",
                "libgio-2.0.so.0()(64bit)",
                "libgobject-2.0.so.0()(64bit)",
                "libglib-2.0.so.0()(64bit)",
                "libgmodule-2.0.so.0()(64bit)",
                "libfreetype.so.6()(64bit)",
            };
        }
    }
    return opt;
}

std::string make_windows_package_wxs(
    const std::string& version,
    const std::string& app_ico
) {
    constexpr std::string_view kProduct = "Hxlings";
    constexpr std::string_view kMaker = "FarnaHerry";
    constexpr std::string_view kMsiUpgrade = "{AB41DC03-9AF1-5EFA-8AC8-0577E1EB2FEA}";
    constexpr std::string_view kAppId = "io.github.farnaherry.hxlings";
    return std::string(
        "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n"
        "<Wix xmlns=\"http://wixtoolset.org/schemas/v4/wxs\">\n"
        "  <Package Codepage=\"65001\" Name=\"") + xml_escape(kProduct) +
        "\" Manufacturer=\"" + xml_escape(kMaker) +
        "\" Version=\"" + xml_escape(version) +
        "\" UpgradeCode=\"" + std::string(kMsiUpgrade) +
        "\" Scope=\"perMachine\">\n"
        "    <MajorUpgrade DowngradeErrorMessage=\"A newer version of [ProductName] is already installed.\" />\n"
        "    <MediaTemplate EmbedCab=\"yes\" />\n"
        "    <Icon Id=\"ApplicationIcon\" SourceFile=\"" + xml_escape(app_ico) + "\" />\n"
        "    <Property Id=\"ARPPRODUCTICON\" Value=\"ApplicationIcon\" />\n"
        "    <Property Id=\"CREATE_DESKTOP_SHORTCUT\" Value=\"0\" Secure=\"yes\" />\n"
        "    <StandardDirectory Id=\"ProgramFiles64Folder\">\n"
        "      <Directory Id=\"INSTALLFOLDER\" Name=\"" + xml_escape(kProduct) + "\">\n"
        "        <Component Id=\"MainExecutable\">\n"
        "          <File Id=\"MainExecutable\" Source=\"$(Executable)\" KeyPath=\"yes\" />\n"
        "        </Component>\n"
        "      </Directory>\n"
        "    </StandardDirectory>\n"
        "    <StandardDirectory Id=\"ProgramMenuFolder\">\n"
        "      <Directory Id=\"APPLICATIONPROGRAMMENU\" Name=\"" + xml_escape(kProduct) + "\" />\n"
        "    </StandardDirectory>\n"
        "    <StandardDirectory Id=\"DesktopFolder\" />\n"
        "    <Component Id=\"ApplicationShortcut\" Directory=\"APPLICATIONPROGRAMMENU\">\n"
        "      <Shortcut Id=\"ApplicationStartMenuShortcut\" Name=\"" + xml_escape(kProduct) + "\"\n"
        "                Target=\"[INSTALLFOLDER]hxlings.exe\" WorkingDirectory=\"INSTALLFOLDER\"\n"
        "                Icon=\"ApplicationIcon\" />\n"
        "      <RemoveFolder Id=\"RemoveApplicationProgramMenu\" On=\"uninstall\" />\n"
        "      <RegistryValue Root=\"HKLM\" Key=\"Software\\" + std::string(kAppId) + "\\" +
        std::string(kProduct) + "\" Name=\"installed\" Type=\"integer\" Value=\"1\" KeyPath=\"yes\" />\n"
        "    </Component>\n"
        "    <Component Id=\"ApplicationDesktopShortcut\" Directory=\"DesktopFolder\">\n"
        "      <Shortcut Id=\"ApplicationDesktopShortcutLink\" Name=\"" + xml_escape(kProduct) + "\"\n"
        "                Target=\"[INSTALLFOLDER]hxlings.exe\" WorkingDirectory=\"INSTALLFOLDER\"\n"
        "                Icon=\"ApplicationIcon\" />\n"
        "      <RegistryValue Root=\"HKLM\" Key=\"Software\\" + std::string(kAppId) + "\\" +
        std::string(kProduct) + "\" Name=\"desktopShortcut\" Type=\"integer\" Value=\"1\" KeyPath=\"yes\" />\n"
        "    </Component>\n"
        "    <Feature Id=\"Application\" Title=\"" + xml_escape(kProduct) + "\" Level=\"1\">\n"
        "      <ComponentRef Id=\"MainExecutable\" />\n"
        "      <ComponentGroupRef Id=\"StagedFiles\" />\n"
        "      <ComponentRef Id=\"ApplicationShortcut\" />\n"
        "    </Feature>\n"
        "    <Feature Id=\"DesktopShortcut\" Title=\"Desktop shortcut\" Level=\"2\" AllowAbsent=\"yes\">\n"
        "      <Level Value=\"1\" Condition=\"CREATE_DESKTOP_SHORTCUT = 1\" />\n"
        "      <ComponentRef Id=\"ApplicationDesktopShortcut\" />\n"
        "    </Feature>\n"
        "  </Package>\n"
        "</Wix>\n";
}

std::string make_windows_bundle_wxs(
    const std::string& version,
    const std::string& app_ico,
    const std::string& installer_exe,
    const std::vector<std::pair<std::string, std::string>>& payloads
) {
    constexpr std::string_view kProduct = "Hxlings";
    constexpr std::string_view kMaker = "FarnaHerry";
    constexpr std::string_view kBundleUpgrade = "{6FD6C90A-35C1-5FA5-9846-8CD75DBC05D6}";
    std::string doc =
        "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n"
        "<Wix xmlns=\"http://wixtoolset.org/schemas/v4/wxs\">\n"
        "  <Bundle Name=\"" + xml_escape(kProduct) +
        "\" Manufacturer=\"" + xml_escape(kMaker) +
        "\" Version=\"" + xml_escape(version) +
        "\" UpgradeCode=\"" + std::string(kBundleUpgrade) +
        "\" IconSourceFile=\"" + xml_escape(app_ico) + "\">\n"
        "    <BootstrapperApplication SourceFile=\"" + xml_escape(installer_exe) + "\">\n"
        "      <PayloadGroupRef Id=\"HxlingsInstallerPayloads\" />\n"
        "    </BootstrapperApplication>\n"
        "    <Variable Name=\"InstallFolder\" Type=\"formatted\" Value=\"[ProgramFiles64Folder]" +
        xml_escape(kProduct) + "\" />\n"
        "    <Variable Name=\"CreateDesktopShortcut\" Type=\"numeric\" Value=\"0\" />\n"
        "    <Chain>\n"
        "      <MsiPackage SourceFile=\"$(Msi)\">\n"
        "        <MsiProperty Name=\"INSTALLFOLDER\" Value=\"[InstallFolder]\" />\n"
        "        <MsiProperty Name=\"CREATE_DESKTOP_SHORTCUT\" Value=\"[CreateDesktopShortcut]\" />\n"
        "      </MsiPackage>\n"
        "    </Chain>\n"
        "  </Bundle>\n"
        "  <Fragment>\n"
        "    <PayloadGroup Id=\"HxlingsInstallerPayloads\">\n";
    for (const auto& [source_file, target_name] : payloads) {
        doc += "      <Payload SourceFile=\"" + xml_escape(source_file) +
               "\" Name=\"" + xml_escape(target_name) + "\" />\n";
    }
    doc +=
        "    </PayloadGroup>\n"
        "  </Fragment>\n"
        "</Wix>\n";
    return doc;
}

bool plan_windows_wix(const std::string& program) {
    const char* raw_version = mcpp::package_version();
    const std::string version = (raw_version != nullptr && *raw_version != '\0')
        ? std::string(raw_version)
        : std::string("0.1.0");

    mcpp::dist::wix::options installer;
    installer.target = program;
    installer.product_name = "Hxlings";
    installer.manufacturer = "FarnaHerry";
    installer.version = version;
    installer.upgrade_code = "{AB41DC03-9AF1-5EFA-8AC8-0577E1EB2FEA}";

    const std::string_view fmt = mcpp::pack_format();
    if (fmt == "msi" || fmt == "setup") {
        const std::filesystem::path manifest(mcpp::manifest_dir());
        const std::filesystem::path out_dir(mcpp::out_dir());
        const std::filesystem::path app_ico = manifest / "platform" / "windows" / "app.ico";
        std::error_code ec;
        if (!std::filesystem::is_regular_file(app_ico, ec)) {
            std::cerr << "hxlings build.mcpp: missing Windows icon at " << app_ico.string() << '\n';
            return false;
        }
        const std::filesystem::path pkg_wxs = out_dir / "Hxlings-package.wxs";
        write_if_different(pkg_wxs, make_windows_package_wxs(version, app_ico.string()));
        installer.wxs = pkg_wxs.string();
        installer.inputs.push_back(app_ico.string());

        if (fmt == "setup") {
            const char* env_dir = std::getenv("HXLINGS_WINDOWS_INSTALLER_DIR");
            const std::filesystem::path installer_dir =
                (env_dir != nullptr && *env_dir != '\0')
                    ? std::filesystem::path(env_dir)
                    : (manifest / "platform" / "windows" / "package" / "dist" / "stage");
            const std::filesystem::path installer_exe = installer_dir / "hxlings-installer.exe";
            const std::filesystem::path mbanative = installer_dir / "mbanative.dll";
            const std::filesystem::path res_bin =
                installer_dir / "hxlings-installer.resources" / "huxerui" / "resources.bin";
            if (!std::filesystem::is_regular_file(installer_exe, ec) ||
                !std::filesystem::is_regular_file(mbanative, ec) ||
                !std::filesystem::is_regular_file(res_bin, ec)) {
                std::cerr << "hxlings build.mcpp: HuxerUI custom installer stage missing in "
                          << installer_dir.string()
                          << " (expected hxlings-installer.exe, mbanative.dll, and "
                             "hxlings-installer.resources/huxerui/resources.bin)\n";
                return false;
            }

            std::vector<std::pair<std::string, std::string>> payloads;
            for (auto it = std::filesystem::recursive_directory_iterator(installer_dir, ec);
                 it != std::filesystem::recursive_directory_iterator();
                 it.increment(ec)) {
                if (ec) break;
                if (!it->is_regular_file(ec)) continue;
                std::string rel = std::filesystem::relative(it->path(), installer_dir, ec).generic_string();
                if (ec || rel.empty()) continue;
                if (rel == "hxlings-installer.exe" || rel == "README.md" || rel == "LICENSE" ||
                    rel == "HOST-REQUIREMENTS" || rel == "mcpp-package.json" ||
                    rel.starts_with("share/")) {
                    continue;
                }
                std::ranges::replace(rel, '/', '\\');
                payloads.emplace_back(it->path().string(), std::move(rel));
            }
            std::ranges::sort(payloads, [](const auto& a, const auto& b) { return a.second < b.second; });

            const std::filesystem::path bundle_wxs = out_dir / "Hxlings-bundle.wxs";
            write_if_different(
                bundle_wxs,
                make_windows_bundle_wxs(version, app_ico.string(), installer_exe.string(), payloads)
            );
            installer.bundle_wxs = bundle_wxs.string();
            installer.bundle_inputs.push_back(app_ico.string());
            installer.bundle_inputs.push_back(installer_exe.string());
            for (const auto& [source_file, target_name] : payloads) {
                (void)target_name;
                installer.bundle_inputs.push_back(source_file);
            }
        }
    }

    return mcpp::dist::wix::generate(std::move(installer));
}

// Mirror huxerui::rules::configure({}) cleanly on macOS and Windows:
// - macOS omits dev-time `bundle:*` edges that reference ${mcpp.target_file:<program>}
//   and break `mcpp test` when only test targets are built.
// - Windows delegates packaging to plan_windows_wix() with EmbedCab="yes" and the
//   custom HuxerUI bootstrapper application.
bool configure_custom(bool is_macos, bool is_windows) {
    const std::string root = huxerui::rules::sdk_root();
    if (root.empty()) {
        std::cerr << "huxerui.rules: cannot locate the HuxerUI SDK root\n";
        return false;
    }

    const std::filesystem::path manifest = mcpp::manifest_dir();
    std::vector<std::string> selected;
    std::error_code ec;
    for (auto it = std::filesystem::recursive_directory_iterator(manifest / "src", ec);
         it != std::filesystem::recursive_directory_iterator(); ++it) {
        if (!it->is_regular_file(ec)) continue;
        const std::filesystem::path ext = it->path().extension();
        if (ext != ".cpp" && ext != ".cppm") continue;
        const std::string rel = std::filesystem::relative(it->path(), manifest, ec).generic_string();
        if (!ec && rel != "src/main.cpp") selected.push_back(rel);
    }
    std::ranges::sort(selected);

    const bool generated_interface = huxerui::rules::plan_module_interface();
    const bool has_module_interface = generated_interface || std::ranges::any_of(
        selected, [](const std::string& s) { return s.ends_with(".cppm"); });

    const std::string prelude =
        root + "/buildtools/mcpp/huxerui-build-rules/include/huxerui_scope_prelude.h";
    const std::string_view compiler = mcpp::compiler();
    const bool msvc = compiler.find("msvc") != std::string_view::npos;
    mcpp::include_dir((root + "/buildtools/mcpp/huxerui-build-rules/include").c_str());
    if (!has_module_interface) {
        if (is_windows && msvc) {
            mcpp::cxxflag("/FItypeinfo");
            mcpp::cxxflag(("/FI" + prelude).c_str());
        } else {
            mcpp::cxxflag("-include");
            mcpp::cxxflag("typeinfo");
            mcpp::cxxflag("-include");
            mcpp::cxxflag(prelude.c_str());
        }
    }
    mcpp::rerun_if_changed(prelude.c_str());
    mcpp::rerun_if_changed_glob("src/**/*.cpp");
    mcpp::rerun_if_changed_glob("src/**/*.cppm");
    mcpp::rerun_if_changed_glob("resources/**");

    std::vector<huxerui::rules::edge> edges;
    auto cg = huxerui::rules::plan_codegen(selected);
    std::vector<std::string> transformed;
    for (const auto& e : cg) {
        transformed.push_back(e.inputs.empty() ? std::string{} : e.inputs[0]);
    }
    for (const std::string& rel : selected) {
        const std::string abs = (manifest / rel).string();
        if (std::ranges::find(transformed, abs) == transformed.end()) {
            mcpp::source(abs.c_str());
        }
    }
    if (!cg.empty()) {
        if (is_windows && msvc) {
            mcpp::cxxflag("/wd5030");
        } else if (compiler.find("gcc") != std::string_view::npos) {
            mcpp::cxxflag("-Wno-attributes");
        } else {
            mcpp::cxxflag("-Wno-unknown-attributes");
        }
        std::vector<std::string> seen;
        for (const std::string& rel : selected) {
            const std::string dir = (manifest / rel).parent_path().string();
            if (std::ranges::find(seen, dir) == seen.end()) {
                seen.push_back(dir);
                mcpp::include_dir(dir.c_str());
            }
        }
    }
    edges.insert(edges.end(), cg.begin(), cg.end());

    const auto graph = huxerui::rules::load_graph();
    if (graph.is_root && !graph.programs.empty()) {
        huxerui::rules::write_library_graph(graph);
        huxerui::rules::write_framework_record();
    }

    const huxerui::rules::options opt = make_rules_options();
    auto rs = huxerui::rules::plan_resources(opt, graph, has_module_interface);
    bool has_resource_edges = false;
    for (auto& e : rs) {
        if (is_macos && e.id.starts_with("bundle:")) continue;
        has_resource_edges = true;
        edges.push_back(std::move(e));
    }
    if (has_resource_edges) {
        mcpp::include_dir((std::string(mcpp::out_dir()) + "/hrc/builtin/include").c_str());
    }

    if (!huxerui::rules::submit(edges)) return false;

    bool packaged = true;
    if (graph.is_root) {
        for (const std::string& program : graph.programs) {
            packaged = (is_windows
                ? plan_windows_wix(program)
                : huxerui::rules::plan_packages(opt, program, graph)) && packaged;
        }
    }
    return packaged;
}

} // namespace

int main() {
    const std::string_view target_os = mcpp::target_os();
    const bool is_macos = target_os == "macos";
    const bool is_windows = target_os == "windows";
    if (!is_macos && !is_windows) {
        configure_linux_glibc_compat();
        patch_linux_self_contained_launcher();
    }
    const bool configured = (is_macos || is_windows)
        ? configure_custom(is_macos, is_windows)
        : huxerui::rules::configure(make_rules_options());
    if (!configured) return 1;

    const std::string huxerui_root = mcpp::dep_dir("huxerui");
    if (!huxerui_root.empty()) {
        mcpp::include_dir_after((huxerui_root + "/src").c_str());
        mcpp::source((huxerui_root + "/testing/ui_test.cpp").c_str());
        mcpp::source((huxerui_root + "/testing/testing_platform_adapter.cpp").c_str());
        mcpp::source((huxerui_root + "/testing/ui_snapshot.cpp").c_str());
    }
    return 0;
}
