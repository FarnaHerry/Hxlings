import std;
import mcpp;
import huxerui.rules;

namespace {

void write_if_different(const std::filesystem::path& path, std::string_view bytes) {
    std::error_code ec;
    std::filesystem::create_directories(path.parent_path(), ec);
    if (std::ifstream in(path, std::ios::binary); in) {
        const std::string existing(
            (std::istreambuf_iterator<char>(in)),
            std::istreambuf_iterator<char>());
        if (existing == bytes) return;
    }
    std::ofstream out(path, std::ios::binary | std::ios::trunc);
    if (out) {
        out.write(bytes.data(), static_cast<std::streamsize>(bytes.size()));
    }
}

void configure_linux_glibc_compat() {
    if (std::string_view(mcpp::target_os()) != "linux" ||
        std::string_view(mcpp::target_arch()) != "x86_64") {
        return;
    }
    const std::filesystem::path shim_path =
        std::filesystem::path(mcpp::out_dir()) / "glibc_compat_x86_64.c";
    constexpr std::string_view kShimSource =
        "float __compat_sqrtf(float x);\n"
        "float __compat_atan2f(float y, float x);\n"
        "double __compat_remainder(double x, double y);\n"
        "__asm__(\".symver __compat_sqrtf,sqrtf@GLIBC_2.2.5\");\n"
        "__asm__(\".symver __compat_atan2f,atan2f@GLIBC_2.2.5\");\n"
        "__asm__(\".symver __compat_remainder,remainder@GLIBC_2.2.5\");\n"
        "float __wrap_sqrtf(float x) { return __compat_sqrtf(x); }\n"
        "float __wrap_atan2f(float y, float x) { return __compat_atan2f(y, x); }\n"
        "double __wrap_remainder(double x, double y) { return __compat_remainder(x, y); }\n";
    write_if_different(shim_path, kShimSource);
    mcpp::source(shim_path.string().c_str());
    mcpp::link_lib("m");
    mcpp::link_flag("-Wl,--wrap=sqrtf");
    mcpp::link_flag("-Wl,--wrap=atan2f");
    mcpp::link_flag("-Wl,--wrap=remainder");
}

void patch_linux_self_contained_launcher() {
    if (std::string_view(mcpp::target_os()) != "linux" ||
        std::string_view(mcpp::pack_format()) != "appimage") {
        return;
    }
    const std::string stage_str = mcpp::pack_stage_dir();
    if (stage_str.empty()) return;

    const std::filesystem::path stage(stage_str);
    constexpr std::string_view kOldFlag = "--library-path \"$here/lib\"";
    constexpr std::string_view kNewFlag =
        "--library-path \"$here/lib:/usr/lib/x86_64-linux-gnu:/usr/lib64:/lib/x86_64-linux-gnu:/lib64\"";
    for (const char* name : {"hxlings", "run.sh"}) {
        const std::filesystem::path file = stage / name;
        std::ifstream in(file, std::ios::binary);
        if (!in) continue;
        std::string text((std::istreambuf_iterator<char>(in)), std::istreambuf_iterator<char>());
        in.close();
        if (text.find("/usr/lib64") != std::string::npos) continue;
        const std::size_t pos = text.find(kOldFlag);
        if (pos == std::string::npos) continue;
        text.replace(pos, kOldFlag.size(), kNewFlag);
        write_if_different(file, text);
        std::error_code ec;
        std::filesystem::permissions(
            file,
            std::filesystem::perms::owner_exec | std::filesystem::perms::group_exec |
                std::filesystem::perms::others_exec,
            std::filesystem::perm_options::add,
            ec);
    }
}

huxerui::rules::options make_rules_options() {
    huxerui::rules::options opt{};
    opt.package.categories = {"Development", "Utility"};
    if (std::string_view(mcpp::target_os()) == "linux") {
        const std::string_view fmt = mcpp::pack_format();
        if (fmt == "deb") {
            opt.package.depends = {
                "libgtk-4-1 (>= 4.14)",
                "libepoxy0 (>= 1.5)",
                "libsoup-3.0-0 (>= 3.0)",
                "libpangoft2-1.0-0",
                "libfontconfig1",
            };
        } else if (fmt == "rpm") {
            opt.package.depends = {
                "libgtk-4.so.1()(64bit)",
                "libepoxy.so.0()(64bit)",
                "libsoup-3.0.so.0()(64bit)",
                "libpangoft2-1.0.so.0()(64bit)",
                "libfontconfig.so.1()(64bit)",
                "libpangocairo-1.0.so.0()(64bit)",
                "libpango-1.0.so.0()(64bit)",
                "libcairo.so.2()(64bit)",
                "libcairo-gobject.so.2()(64bit)",
                "libgdk_pixbuf-2.0.so.0()(64bit)",
                "libgraphene-1.0.so.0()(64bit)",
                "libharfbuzz.so.0()(64bit)",
                "libgio-2.0.so.0()(64bit)",
                "libgobject-2.0.so.0()(64bit)",
                "libglib-2.0.so.0()(64bit)",
                "libgmodule-2.0.so.0()(64bit)",
                "libfreetype.so.6()(64bit)",
            };
        }
    }
    return opt;
}

// Mirror huxerui::rules::configure({}) on macOS while omitting dev-time
// `bundle:*` edges that reference ${mcpp.target_file:<program>} and break
// `mcpp test` when only test targets are built. Deployed HuxerUI/ resources
// and release packaging via mcpp::dist::apple remain active.
bool configure_macos() {
    const std::string root = huxerui::rules::sdk_root();
    if (root.empty()) {
        std::cerr << "huxerui.rules: cannot locate the HuxerUI SDK root\n";
        return false;
    }

    const std::filesystem::path manifest = mcpp::manifest_dir();
    std::vector<std::string> selected;
    std::error_code ec;
    for (auto it = std::filesystem::recursive_directory_iterator(manifest / "src", ec);
         it != std::filesystem::recursive_directory_iterator(); ++it) {
        if (!it->is_regular_file(ec)) continue;
        const std::filesystem::path ext = it->path().extension();
        if (ext != ".cpp" && ext != ".cppm") continue;
        const std::string rel = std::filesystem::relative(it->path(), manifest, ec).generic_string();
        if (!ec && rel != "src/main.cpp") selected.push_back(rel);
    }
    std::ranges::sort(selected);

    const bool generated_interface = huxerui::rules::plan_module_interface();
    const bool has_module_interface = generated_interface || std::ranges::any_of(
        selected, [](const std::string& s) { return s.ends_with(".cppm"); });

    const std::string prelude =
        root + "/buildtools/mcpp/huxerui-build-rules/include/huxerui_scope_prelude.h";
    mcpp::include_dir((root + "/buildtools/mcpp/huxerui-build-rules/include").c_str());
    if (!has_module_interface) {
        mcpp::cxxflag("-include");
        mcpp::cxxflag("typeinfo");
        mcpp::cxxflag("-include");
        mcpp::cxxflag(prelude.c_str());
    }
    mcpp::rerun_if_changed(prelude.c_str());
    mcpp::rerun_if_changed_glob("src/**/*.cpp");
    mcpp::rerun_if_changed_glob("src/**/*.cppm");

    std::vector<huxerui::rules::edge> edges;
    auto cg = huxerui::rules::plan_codegen(selected);
    std::vector<std::string> transformed;
    for (const auto& e : cg) {
        transformed.push_back(e.inputs.empty() ? std::string{} : e.inputs[0]);
    }
    for (const std::string& rel : selected) {
        const std::string abs = (manifest / rel).string();
        if (std::ranges::find(transformed, abs) == transformed.end()) {
            mcpp::source(abs.c_str());
        }
    }
    if (!cg.empty()) {
        mcpp::cxxflag("-Wno-unknown-attributes");
        std::vector<std::string> seen;
        for (const std::string& rel : selected) {
            const std::string dir = (manifest / rel).parent_path().string();
            if (std::ranges::find(seen, dir) == seen.end()) {
                seen.push_back(dir);
                mcpp::include_dir(dir.c_str());
            }
        }
    }
    edges.insert(edges.end(), cg.begin(), cg.end());

    const auto graph = huxerui::rules::load_graph();
    if (graph.is_root && !graph.programs.empty()) {
        huxerui::rules::write_library_graph(graph);
        huxerui::rules::write_framework_record();
    }

    const huxerui::rules::options opt = make_rules_options();
    auto rs = huxerui::rules::plan_resources(opt, graph, has_module_interface);
    bool has_resource_edges = false;
    for (auto& e : rs) {
        if (e.id.starts_with("bundle:")) continue;
        has_resource_edges = true;
        edges.push_back(std::move(e));
    }
    if (has_resource_edges) {
        mcpp::include_dir((std::string(mcpp::out_dir()) + "/hrc/builtin/include").c_str());
    }

    if (!huxerui::rules::submit(edges)) return false;

    bool packaged = true;
    if (graph.is_root) {
        for (const std::string& program : graph.programs) {
            packaged = huxerui::rules::plan_packages(opt, program, graph) && packaged;
        }
    }
    return packaged;
}

} // namespace

int main() {
    const bool is_macos = std::string_view(mcpp::target_os()) == "macos";
    if (!is_macos) {
        configure_linux_glibc_compat();
        patch_linux_self_contained_launcher();
    }
    const bool configured = is_macos
        ? configure_macos()
        : huxerui::rules::configure(make_rules_options());
    if (!configured) return 1;

    const std::string huxerui_root = mcpp::dep_dir("huxerui");
    if (!huxerui_root.empty()) {
        mcpp::include_dir_after((huxerui_root + "/src").c_str());
        mcpp::source((huxerui_root + "/testing/ui_test.cpp").c_str());
        mcpp::source((huxerui_root + "/testing/testing_platform_adapter.cpp").c_str());
        mcpp::source((huxerui_root + "/testing/ui_snapshot.cpp").c_str());
    }
    return 0;
}
